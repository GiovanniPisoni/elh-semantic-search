# Database (Supabase)
DB_URI=postgresql://user:password@host:port/database

# Vector store (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=elh-reviews
PINECONE_DESCRIPTIONS_INDEX_NAME=elh-descriptions

# LLM (Anthropic) — answer generation
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Query rewriting
# Toggle to compare Naive vs Advanced RAG in Phase 4 evaluation.
ENABLE_QUERY_REWRITING=true
LLM_REWRITER_MODEL=claude-haiku-4-5-20251001
LLM_REWRITER_MAX_TOKENS=256

#Re-ranking
ENABLE_RERANKING=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_POOL_SIZE=20
RERANKER_BATCH_SIZE=16

# Intent routing
# Toggle for A/B testing.
ENABLE_INTENT_ROUTING=true
INTENT_ROUTER_MODEL=claude-haiku-4-5-20251001
INTENT_ROUTER_CONFIDENCE_THRESHOLD=0.8
INTENT_ROUTER_MAX_TOKENS=200

# Embeddings
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# Retrieval
RETRIEVAL_TOP_K=5

# Indexing
INDEXING_BATCH_SIZE=32
INDEXING_UPSERT_BATCH=100
MIN_TEXT_LENGTH=30

# Logging
LOG_LEVEL=INFO
